  "services": {
    "add_fuel": {
      "name": "Add a fill-up",
      "description": "Records a fill-up. Values are in the vehicle's units; two of quantity, amount and unit price are enough. Coherence warnings are logged and returned, but do not block saving unless strict mode is on.",
      "fields": {
        "vehicle": {
          "name": "Vehicle",
          "description": "Vehicle device."
        },
        "odometer": {
          "name": "Odometer",
          "description": "Odometer reading, in the vehicle's distance unit."
        },
        "volume": {
          "name": "Quantity",
          "description": "Litres, gallons, or kg for CNG."
        },
        "total_cost": {
          "name": "Amount",
          "description": "Total amount paid."
        },
        "unit_price": {
          "name": "Unit price",
          "description": "Price per litre, gallon or kg."
        },
        "date": {
          "name": "Date",
          "description": "Defaults to now."
        },
        "time": {
          "name": "Time",
          "description": "Optional."
        },
        "fuel_type": {
          "name": "Fuel",
          "description": "Defaults to the vehicle's main fuel."
        },
        "full_tank": {
          "name": "Full tank",
          "description": "Off for a partial fill-up."
        },
        "station": {
          "name": "Station",
          "description": "Optional."
        },
        "notes": {
          "name": "Notes",
          "description": "Optional."
        },
        "strict": {
          "name": "Strict",
          "description": "Refuse the fill-up if a coherence check fails."
        }
      }
    },
    "add_expense": {
      "name": "Add an expense",
      "description": "Records an expense for a vehicle.",
      "fields": {
        "vehicle": {
          "name": "Vehicle",
          "description": "Vehicle device."
        },
        "amount": {
          "name": "Amount",
          "description": "Amount paid."
        },
        "category": {
          "name": "Category",
          "description": "Category identifier (maintenance, insurance, parking, toll, inspection, repair, other) or name."
        },
        "date": {
          "name": "Date",
          "description": "Defaults to today."
        },
        "odometer": {
          "name": "Odometer",
          "description": "Optional, in the vehicle's distance unit."
        },
        "description": {
          "name": "Description",
          "description": "Optional."
        }
      }
    },
    "update_odometer": {
      "name": "Update odometer",
