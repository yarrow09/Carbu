      "user": {
        "title": "Vehicle Log",
        "description": "Install the vehicle log. You will then add your vehicles with the \"Add vehicle\" button on the integration page."
      }
    },
    "abort": {
      "single_instance_allowed": "Vehicle Log is already configured."
    }
  },
  "config_subentries": {
