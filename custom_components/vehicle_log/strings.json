      "step": {
        "identity": {
          "title": "Vehicle (1/4): identity",
          "data": {
            "name": "Name",
            "make": "Make",
            "model": "Model",
            "plate": "Registration plate",
            "acquisition_date": "Acquisition date"
          },
          "data_description": {
            "name": "Shown on the dashboard and in entity names.",
            "plate": "Optional."
          }
        },
        "units": {
          "title": "Vehicle (2/4): units",
          "description": "Units used to enter and display data for this vehicle. Data is stored in metric units, so you can change them at any time.",
          "data": {
            "distance_unit": "Distance",
            "volume_unit": "Volume",
            "consumption_unit": "Consumption"
          }
        },
        "fuel": {
          "title": "Vehicle (3/4): fuel",
          "data": {
            "fuel_type": "Fuel",
            "tank_capacity": "Tank capacity ({volume_unit}, kg for CNG)",
            "bifuel": "Bi-fuel vehicle"
          },
          "data_description": {
            "tank_capacity": "Optional. Used to flag fill-ups larger than the tank."
          }
        },
        "secondary_fuel": {
          "title": "Vehicle (3/4): second fuel",
          "data": {
            "secondary_fuel_type": "Second fuel",
            "secondary_tank_capacity": "Second tank capacity ({volume_unit}, kg for CNG)"
          }
        },
        "consumption": {
          "title": "Vehicle (4/4): plausible consumption",
          "description": "A fill-up whose consumption falls outside this range triggers a warning (in the consumption unit chosen for the vehicle).",
          "data": {
            "consumption_min": "Minimum",
            "consumption_max": "Maximum"
          }
        }
      },
      "error": {
        "name_required": "A name is required.",
        "name_exists": "A vehicle with this name already exists.",
        "same_fuel": "The second fuel must differ from the main fuel.",
        "invalid_range": "Invalid range: both values must be positive and different."
      }
    }
  },
