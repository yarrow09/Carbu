        "vehicle": {
          "name": "Vehicle",
          "description": "Vehicle device."
        },
        "odometer": {
          "name": "Odometer",
          "description": "Reading, in the vehicle's distance unit."
        },
        "strict": {
          "name": "Strict",
          "description": "Refuse a reading lower than the previous one."
        }
      }
    },
    "export_data": {
      "name": "Export data",
      "description": "Writes all fill-ups, expenses, odometer readings, reminders and categories as CSV files in the vehicle_log/exports folder of the configuration directory."
